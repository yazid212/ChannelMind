# Required external APIs
YOUTUBE_API_KEY=
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_MODEL_PATH=data/models
YOUTUBE_TRANSCRIPT_TRUST_ENV=false
# Recommended on cloud hosts where YouTube blocks datacenter IPs.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
WEBSHARE_PROXY_LOCATIONS=
YOUTUBE_TRANSCRIPT_RETRIES=5
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional alternative providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROK_API_KEY=
GROK_MODEL=grok-4.3
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# API security and public-demo limits
APP_ENV=development
APP_SECRET=development-only-change-me
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
EXPORT_STORE_PATH=data/channel-exports.sqlite3
TRUST_PROXY_HEADERS=false
# Only set this with an ingress whose source CIDR you control. Railway sends
# X-Real-IP; other trusted proxies may send X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
MAX_PUBLIC_VIDEOS=10
MAX_CATALOG_VIDEOS=2000
ON_DEMAND_VIDEOS=2
CATALOG_SEARCH_K=12
WORKSPACE_TTL_SECONDS=86400
MAX_REQUEST_BYTES=32768

# Optional channel exporter extension (Google OAuth Web application client).
# Set a random APP_SECRET of at least 32 characters before enabling OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Chrome extension IDs, shown on chrome://extensions.
CHANNELMIND_EXTENSION_IDS=
EXPORT_RETENTION_SECONDS=86400

# Local defaults. Production should set Redis and Qdrant values.
REDIS_URL=
VECTOR_BACKEND=chroma
VECTORSTORE_PATH=vectorstore
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=youtube_transcripts
ENABLE_TRANSCRIPT_CACHE=false
TRANSCRIPT_CACHE_PATH=data/transcripts

# Retrieval and cost controls
TOP_K=3
DIVERSE_FETCH_K=100
LLM_MAX_TOKENS=600
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_LOCAL_FILES_ONLY=true
